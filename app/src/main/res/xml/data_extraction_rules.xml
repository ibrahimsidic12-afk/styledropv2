<?xml version="1.0" encoding="utf-8"?>
<!--
  SECURITY (Agent #14): API 31+ cloud backup + device transfer.
  Wardrobe DB + encrypted photos + prefs are excluded from BOTH paths.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="styledrop_database" />
        <exclude domain="database" path="styledrop_database-wal" />
        <exclude domain="file" path="wardrobe_photos" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="styledrop_database" />
        <exclude domain="file" path="wardrobe_photos" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

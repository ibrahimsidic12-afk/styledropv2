diff --git a/app/src/main/java/com/example/ui/A11y.kt b/app/src/main/java/com/example/ui/A11y.kt
new file mode 100644
index 0000000..4d7eb63
--- /dev/null
+++ b/app/src/main/java/com/example/ui/A11y.kt
@@ -0,0 +1,27 @@
+package com.example.ui
+
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.res.stringResource
+import com.example.R
+import com.example.models.ItemCategory
+
+/**
+ * Maps raw category values persisted in Room (ItemCategory constants) to their
+ * localized display strings. Database values stay canonical English keys so
+ * existing data is not invalidated by a locale change; only display is translated.
+ */
+private val categoryStringRes = mapOf(
+    ItemCategory.TOP to R.string.category_tops,
+    ItemCategory.BOTTOM to R.string.category_bottoms,
+    ItemCategory.SHOES to R.string.category_shoes,
+    ItemCategory.OUTERWEAR to R.string.category_outerwear,
+    ItemCategory.ACCESSORY to R.string.category_accessories,
+    ItemCategory.BAG to R.string.category_bags,
+    ItemCategory.WATCH to R.string.category_watches,
+    ItemCategory.JEWELRY to R.string.category_jewelry
+)
+
+/** Localized display name for a wardrobe category, falling back to the raw key. */
+@Composable
+fun categoryDisplay(category: String): String =
+    categoryStringRes[category]?.let { stringResource(it) } ?: category
